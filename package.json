{
  "name": "vite-vue-pwa-capacitor",
  "private": true,
  "version": "0.0.9",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "build:gh": "vite build --base=/vite-vue-pwa-capacitor/ && node scripts/spa-github-pages.js && node scripts/verify-dist.mjs",
    "preview": "vite preview --host",
    "verify:dist": "node scripts/verify-dist.mjs",
    "mobile": "vite build && vite preview --host"
  },
  "dependencies": {
    "@capacitor/core": "^8.4.2",
    "vue": "^3.5.39",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.7",
    "vite": "^8.1.1",
    "vite-plugin-pwa": "^1.3.0",
    "workbox-window": "^7.4.1"
  }
}
